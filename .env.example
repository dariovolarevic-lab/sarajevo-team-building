# MXroute SMTP delivers proposal requests.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
TO_EMAIL=
# Optional; defaults to "Sarajevo Team Building <SMTP_USER>"
SMTP_FROM=

# Public site URL (used for canonical links, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://sarajevoteambuilding.com
# Set to "staging" on preview/staging deployments to serve noindex and Disallow: /
NEXT_PUBLIC_SITE_ENV=production
